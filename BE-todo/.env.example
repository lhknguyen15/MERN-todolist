DATABASE_USERNAME=your-mongodb-database-user
DATABASE_PASSWORD=your-mongodb-database-password
MONGODB_CLUSTER_HOST=cluster0.xxxxx.mongodb.net
# Alternatively, provide the complete connection string in MONGODB_URI.
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
CORS_ORIGINS=http://localhost:5173,https://fe-todo-seven.vercel.app,https://fe-todo-git-main-lhknguyens-projects.vercel.app
